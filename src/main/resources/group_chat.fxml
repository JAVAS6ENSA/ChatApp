<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Views.GroupChatController" styleClass="chat-area">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="chat-header">
            <HBox fx:id="avatarBox" alignment="CENTER" onMouseClicked="#onShowInfo" style="-fx-cursor: hand;"/>
            <VBox spacing="2" onMouseClicked="#onShowInfo" style="-fx-cursor: hand;" HBox.hgrow="ALWAYS">
                <Label fx:id="groupNameLabel" text="Group Name" styleClass="title-md"/>
                <Label fx:id="memberCountLabel" text="Loading members..." styleClass="text-muted"/>
            </VBox>
            <HBox fx:id="memberAvatarsBox" alignment="CENTER_RIGHT" spacing="-10">
                <padding><Insets right="10"/></padding>
            </HBox>
            <Button fx:id="addMemberBtn" text="+" onAction="#onAddMember" styleClass="btn-icon-green"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="messagesScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-dark">
            <VBox fx:id="messagesBox" spacing="6">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8" styleClass="chat-input-bar" alignment="CENTER">
            <Button fx:id="attachBtn" text="📎" onAction="#onAttachFile" styleClass="btn-icon-grey"/>
            <TextField fx:id="messageInput" promptText="Type a group message" styleClass="input-dark" HBox.hgrow="ALWAYS"/>
            <Button fx:id="audioBtn" text="🎤" onMousePressed="#onStartRecording" onMouseReleased="#onStopRecording" styleClass="btn-icon-grey"/>
            <Button fx:id="sendBtn" text="▶" onAction="#sendMessage" styleClass="btn-send-wa"/>
        </HBox>
    </bottom>
</BorderPane>
