<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="Views.CallController"
           prefWidth="350" prefHeight="500" style="-fx-background-color: #0f1117;">

    <VBox fx:id="mainLayout" spacing="30" alignment="CENTER" style="-fx-padding: 40;">

        <!-- Avatar -->
        <StackPane fx:id="avatarPane">
            <Circle fx:id="avatarCircle" radius="60" fill="#4f8ef7"
                    stroke="#4f8ef74d" strokeWidth="10"/>
            <Label fx:id="avatarLabel" textFill="white"
                   style="-fx-font-size: 40; -fx-font-weight: bold;"/>
        </StackPane>

        <!-- Info -->
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="nameLabel" textFill="#e8eaf0"
                   style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            <Label fx:id="statusLabel" textFill="#6b7280"
                   style="-fx-font-size: 16;"/>
            <Label fx:id="timerLabel" text="00:00" textFill="#4f8ef7"
                   style="-fx-font-size: 14;" visible="false" managed="false"/>
        </VBox>

        <!-- Controls -->
        <HBox fx:id="controlsBox" spacing="20" alignment="CENTER"/>
    </VBox>
</StackPane>
