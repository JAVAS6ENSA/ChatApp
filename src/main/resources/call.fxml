<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Views.CallController" spacing="12" styleClass="card">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
    <Label text="Call Details" styleClass="section-title"/>
    <HBox spacing="8"><Label text="Type:" styleClass="text-muted"/><Label fx:id="callTypeLabel" text="AUDIO"/></HBox>
    <HBox spacing="8"><Label text="State:" styleClass="text-muted"/><Label fx:id="callStateLabel" text="Idle"/></HBox>
    <HBox spacing="8">
        <Button text="Accept" styleClass="btn-primary"/>
        <Button text="Decline" styleClass="btn-danger"/>
    </HBox>
</VBox>

