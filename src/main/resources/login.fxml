<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" style="-fx-padding: 40; -fx-max-width: 300;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="Views.loginController">

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Connexion" />

    <TextField fx:id="usernameField" promptText="Nom d'utilisateur" />

    <PasswordField fx:id="passwordField" promptText="Mot de passe" />

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" wrapText="true" />

    <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" text="Se connecter" />

    <Button onAction="#goToRegister" style="-fx-background-color: transparent; -fx-text-fill: #0078D4;" text="Créer un compte" />
</VBox>
